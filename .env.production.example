# Copy to .env on the VPS (next to docker-compose.yml). Never commit .env.
# Generate secrets with: openssl rand -hex 32

# Caddy / domain (DuckDNS subdomain pointing to the VPS IP)
API_DOMAIN=minhaloja.duckdns.org

# Postgres (hex only: the password goes inside DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-hex
POSTGRES_DB=ecommerce

# Vercel production URL (exact origin, no trailing slash)
FRONTEND_URL=https://seu-projeto.vercel.app

JWT_SECRET=change-me
REFRESH_SECRET=change-me
LOG_HASH_SECRET=change-me

MAIL_USER=
MAIL_PASSWORD=

# Stripe: webhook endpoint https://<API_DOMAIN>/webhooks/stripe, secret whsec_... from the dashboard
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

LOG_LEVEL=http
LOG_RETENTION_APP=90d
LOG_RETENTION_ACCESS=180d
RATE_LIMIT_AUTH=5
