{
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^4.1.1",
    "prettier": "^3.6.2",
    "prisma": "^7.4.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "name": "e-commerce-back-end",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.ts",
  "scripts": {
    "start": "cross-env NODE_ENV=production tsx src/app.ts",
    "dev": "tsx watch --clear-screen=false src/app.ts",
    "build": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "lint:format": "npm run lint:fix && npm run format",
    "prisma:dev": "npx prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:load": "tsx tests/load/bomb.ts",
    "e2e:server": "tsx tests/support/e2e-server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.3.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.11",
    "pg": "^8.20.0",
    "sharp": "^0.34.5",
    "stripe": "^22.3.2",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.1.12"
  }
}
