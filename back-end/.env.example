# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/e-commerce"

PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# JWT secrets (any long random strings)
JWT_SECRET="change-me-access"
REFRESH_SECRET="change-me-refresh"

# Gmail SMTP (App Password). Leave empty to skip e-mails; the app keeps working.
MAIL_USER=""
MAIL_PASSWORD=""

# Stripe TEST keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
# `stripe listen --forward-to localhost:3000/webhooks/stripe` prints this; "dev" skips signature check locally
STRIPE_WEBHOOK_SECRET="dev"

# Logs (LGPD) — see docs/LGPD-LOGS.md
LOG_LEVEL=http
LOG_HASH_SECRET="change-me-log-pseudonym-key"
LOG_RETENTION_APP=90d
LOG_RETENTION_ACCESS=180d

# Login/register attempts per minute per IP
RATE_LIMIT_AUTH=5

# Integration/E2E tests use this database (created automatically). Defaults to <DATABASE_URL db>-test
# DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/e-commerce-test"
